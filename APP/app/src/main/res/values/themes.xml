<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.APP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryContainer">@color/mint</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.APP" parent="Base.Theme.APP" />

    <style name="TextAppearance.SubTrack.BottomNavigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
